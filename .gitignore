database/*.db-journal
database/*.db-wal
database/*.db-shm
database/*.bak
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak

# Environment variables & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
